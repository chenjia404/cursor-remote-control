{
  "name": "cursor-remote-control",
  "version": "0.4.7",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/src/server.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/public --max-warnings 0",
    "init-admin": "tsx scripts/init-admin.ts",
    "generate-icons": "tsx scripts/generate-icons.ts",
    "autostart:install": "pwsh -NoProfile -File scripts/install-autostart.ps1",
    "autostart:uninstall": "pwsh -NoProfile -File scripts/uninstall-autostart.ps1",
    "autostart:start": "pwsh -NoProfile -File scripts/start-server.ps1",
    "autostart:watch": "pwsh -NoProfile -File scripts/watchdog.ps1",
    "autostart:watch:stop": "pwsh -NoProfile -File scripts/stop-watchdog.ps1"
  },
  "dependencies": {
    "@cursor/sdk": "latest",
    "@fastify/cookie": "latest",
    "@fastify/helmet": "latest",
    "@fastify/rate-limit": "latest",
    "@fastify/static": "latest",
    "croner": "^10.0.1",
    "dompurify": "^3.4.13",
    "dotenv": "latest",
    "fastify": "latest",
    "marked": "^18.0.9",
    "zod": "latest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "latest",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "sharp": "^0.35.3",
    "tsx": "latest",
    "typescript": "latest"
  }
}
