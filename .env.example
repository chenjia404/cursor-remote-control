NODE_ENV=development
HOST=0.0.0.0
PORT=20267
# 用户侧公网地址（含 https://）。本服务仍只监听上面的 HTTP PORT，HTTPS 由反代终止。
PUBLIC_BASE_URL=

CURSOR_API_KEY=cursor_xxx
CURSOR_MODEL=auto
CURSOR_DEFAULT_MODE=agent

ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
PROJECT_ROOTS=E:\code;D:\code;C:\code
DATA_DIR=./data
# 用户通过 HTTPS 反代访问时设为 true。也可留空，若 PUBLIC_BASE_URL 为 https 则自动启用。
COOKIE_SECURE=false

ENABLE_TOTP=false
